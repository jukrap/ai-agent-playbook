{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/forge/**/*.mjs",
    "src/runtime/python-engine.mjs",
    "src/runtime/writing-naturalness.mjs",
    "src/fs-safety.mjs",
    "src/records.mjs",
    "src/skills-lifecycle.mjs",
    "src/catalog/selection.mjs",
    "src/cli.mjs",
    "src/mcp-server.mjs",
    "src/mcp-tools.mjs"
  ]
}
